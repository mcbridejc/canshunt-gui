{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CANShunt",
  "version": "0.1.0",
  "identifier": "com.relativejump.canshunt",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "CANShunt", "width": 1180, "height": 760, "minWidth": 900, "minHeight": 620 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": [] }
}
